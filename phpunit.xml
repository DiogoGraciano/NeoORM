<?xml version="1.0" encoding="UTF-8"?>
<!--
    Configuração PADRÃO: suíte unitária, sem banco nenhum.

    Não há <env> de banco aqui de propósito. `composer test:unit` não consegue
    tocar um servidor nem por acidente, e UnitTestCase falha qualquer teste que
    abra conexão. Para integração use phpunit-pgsql.xml / phpunit-mysql.xml.

    O schema aponta para o xsd INSTALADO, então nunca mais desalinha da versão
    do PHPUnit em uso.

    Sem bloco <coverage>: com o pcov desligado por padrão (pcov.ini na imagem),
    declarar relatório de cobertura aqui gera um aviso de "no code coverage
    driver available" que, com failOnWarning, derruba a suíte inteira. A
    cobertura é pedida explicitamente por `composer test:coverage`.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         testdox="true"
         executionOrder="random"
         resolveDependencies="true"
         beStrictAboutOutputDuringTests="true"
         beStrictAboutTestsThatDoNotTestAnything="true"
         beStrictAboutChangesToGlobalState="true"
         failOnRisky="true"
         failOnWarning="true"
         failOnNotice="true"
         failOnDeprecation="true">
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
    </testsuites>
    <source restrictNotices="true" restrictWarnings="true">
        <include>
            <directory>src</directory>
        </include>
    </source>
    <php>
        <env name="NEOORM_DISABLE_DOTENV" value="1"/>
        <ini name="error_reporting" value="E_ALL"/>
        <ini name="date.timezone" value="UTC"/>
    </php>
</phpunit>
